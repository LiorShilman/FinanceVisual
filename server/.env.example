PORT=36600
# comma-separated list of allowed browser origins (defaults to FinanceVisual's production origin +
# local dev if unset — see src/index.js)
CORS_ORIGINS=https://shilmanlior2608.ddns.net:35000,http://localhost:5173

# --- AI insights (OpenAI) ---
# no key here — this server is a stateless proxy for it, and every caller sends their own key as
# `Authorization: Bearer <key>` (see FinanceVisual's own settings panel). There's no "default
# account" fallback for this feature the way RiseUp has one below.

# --- RiseUp proxy ---
# optional — the server is multi-tenant, each caller (e.g. a FinanceVisual account) normally sends
# its own token as `Authorization: Bearer <token>`. This is only the fallback used when no such
# header is present (RiseUp/client, this project's own local dashboard).
RISEUP_PAT=riseup_pat_paste_your_token_here
RISEUP_API_BASE=https://input.riseup.co.il

# --- RiseUp/client's own chat feature ---
ANTHROPIC_API_KEY=paste_your_anthropic_api_key_here
