rules_version = '2';

// One user's board lives entirely under users/{uid}/board/main — only that same authenticated
// user may read or write it. No board is ever shared between users (see the plan: one user per
// board), so there's no need for any broader sharing rule here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
